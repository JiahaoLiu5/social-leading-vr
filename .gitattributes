# Text is stored and checked out with LF
* text=auto eol=lf

# Source and documents
*.cs            text eol=lf diff=csharp
*.shader        text eol=lf
*.shadergraph   text eol=lf
*.cginc         text eol=lf
*.hlsl          text eol=lf
*.compute       text eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.inputactions  text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.yml           text eol=lf
*.cff           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.gradle        text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
LICENSE         text eol=lf

# Unity YAML
*.unity         text eol=lf
*.prefab        text eol=lf
*.asset         text eol=lf
*.mat           text eol=lf
*.meta          text eol=lf
*.anim          text eol=lf
*.controller    text eol=lf
*.overrideController text eol=lf
*.mask          text eol=lf
*.preset        text eol=lf
*.renderTexture text eol=lf
*.physicMaterial text eol=lf
*.mixer         text eol=lf
*.playable      text eol=lf

# Unity data that stays binary even with text serialization
LightingData.asset binary


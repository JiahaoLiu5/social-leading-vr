      propertyPath: m_text
      value: 'Your Standpoint: Social Media Drives People Apart'
      objectReference: {fileID: 0}
    - target: {fileID: 2049953955419727206, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_text
      value: 'The Impact of Social Media on Social Interaction

'
      objectReference: {fileID: 0}
    - target: {fileID: 2066792656370897600, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_text
      value: '" Does social media bring people together

        or drive people
        further apart? "'
      objectReference: {fileID: 0}
    - target: {fileID: 3488716023689871269, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_text
      value: '*Tips: When you are debating with your partner, combining verbal communication
        with

        non-verbal movements and gestures can make your argument more
        compelling.'
      objectReference: {fileID: 0}

      propertyPath: m_LocalEulerAnglesHint.y
      value: -90
      objectReference: {fileID: 0}
    - target: {fileID: 4595321161304435684, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6294240365456108621, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_text
      value: "\tSocial media is part of our daily lives, profoundly shaping how we
        communicate and interact with one another. Supporters argue that platforms
        like Facebook, Tiktok, and Instagram have brought people closer together,
        fostering global connections, facilitating instant communication, and enabling
        the sharing of diverse ideas and cultures. Critics, however, argue that social
        media has led to increased feelings of isolation, superficial relationships,
        and echo chambers where individuals are exposed primarily to viewpoints similar
        to their own."
      objectReference: {fileID: 0}
    - target: {fileID: 7966361940303417088, guid: 2c556a71150b42e36fbc2bc2e33b9330, type: 3}
      propertyPath: m_text
      value: <u><smallcaps>Idea Generation and Debate</smallcaps></u>
      objectReference: {fileID: 0}

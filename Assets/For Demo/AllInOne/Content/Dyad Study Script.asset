  steps:
  - id: wave
    title: Wave and say hi
    clip: {fileID: 8300000, guid: 9bdf0d7e6f1317342b5652d106a9e016, type: 3}
    captions:
    - start: 0
      end: 0
      text: Welcome to the social chatting room.
    - start: 2.5
      end: 0
      text: In front of you, you can see your partner.
    - start: 5.3
      end: 0
      text: Please wave and say hi to your partner.
    hint: Wave to your partner.
    responseSeconds: 10
    quickSeconds: -1
    minResponseSeconds: 2
    rule: 1
    usualShare: 1
    showTimer: 0
    cues: []
    bots:
    - clock: 0
      at: 0
      place: 1
      distance: 0.85
      motion: 0
      alternate: 0
      interval: 0
    - clock: 0
      at: 5.2
      place: 0
      distance: 0.85
      motion: 1
      alternate: 0
      interval: 0
    botDoneSeconds: 8
  - id: handshake
    title: Shake hands
    clip: {fileID: 8300000, guid: e1ef7f629061c3c4fb844c4d3775aeb3, type: 3}
    captions:
    - start: 0
      end: 0
      text: Great! Please come closer to each other
    - start: 3.5
      end: 0
      text: and shake hands with your partner.
    hint: Walk closer and shake hands.
    responseSeconds: 15
    quickSeconds: -1
    minResponseSeconds: 2
    rule: 1
    usualShare: 1
    showTimer: 0
    cues: []
    bots:

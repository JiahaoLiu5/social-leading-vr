      distance: 0.85
      motion: 0
      alternate: 0
      interval: 0
    - clock: 1
      at: 0
      place: 2
      distance: 0.85
      motion: 11
      alternate: 0
      interval: 0
    botDoneSeconds: 8
  - id: highfive
    title: High five
    clip: {fileID: 8300000, guid: 4f84e721651ff4b429bbbadf5eb458e5, type: 3}
    captions:
    - start: 0
      end: 0
      text: Excellent! Today, you will be completing several interaction tasks with
        your partner.
    - start: 6.2
      end: 0
      text: Please high-five with your partner to mark the beginning of today's journey.
    hint: High five.
    responseSeconds: 10
    quickSeconds: -1
    minResponseSeconds: 2
    rule: 1
    usualShare: 1
    showTimer: 0
    cues: []
    bots:
    - clock: 0
      at: 0
      place: 2
      distance: 0.75
      motion: 0
      alternate: 0
      interval: 0
    - clock: 0
      at: 7.4
      place: 2
      distance: 0.75
      motion: 10
      alternate: 0
      interval: 0
    botDoneSeconds: 8
  - id: mirror
    title: Movements at the mirror
    clip: {fileID: 8300000, guid: d8c71c98d4b9fe146b9553739d89a361, type: 3}
    captions:
    - start: 0
      end: 0
      text: Great! On one side of the room, there is a mirror.
    - start: 4.5
      end: 0
      text: Please turn to the mirror side and perform the following movements.
    - start: 10.7
      end: 0
      text: Tilt and nod your head.
    - start: 15.4
      end: 0
      text: Raise your left hand above your head and then lower it down.
    - start: 22.2
      end: 0
      text: Raise your right hand above your head and then lower it down.
    - start: 29.2
      end: 0
      text: Raise your two hands above your head and then lower them down.
    hint: Turn to the mirror and follow the movements.
    responseSeconds: 15
    quickSeconds: -1
    minResponseSeconds: 2
    rule: 1
    usualShare: 1
    showTimer: 0
    cues: []
    bots:
    - clock: 0
      at: 0
      place: 0
      distance: 0.85
      motion: 0
      alternate: 0
      interval: 0
    - clock: 0
      at: 5
      place: 3
      distance: 0.85
      motion: 0
      alternate: 0
      interval: 0
    - clock: 0
      at: 12.2
      place: 3
      distance: 0.85
      motion: 6
      alternate: 0
      interval: 0
    - clock: 0
      at: 14.7
      place: 3
      distance: 0.85
      motion: 0
      alternate: 0
      interval: 0
    - clock: 0
      at: 17
      place: 3
      distance: 0.85
      motion: 7
      alternate: 0
